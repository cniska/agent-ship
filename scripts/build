#!/usr/bin/env bash
set -euo pipefail

TARGETS=(darwin-arm64 linux-x64)

die() {
  printf 'build: %s\n' "$1" >&2
  exit 1
}

build_target() {
  local root="$1" target="$2" staging
  staging="$root/dist/$target"
  mkdir -p "$staging"
  bun build --compile --target "bun-$target" "$root/src/cli.ts" --outfile "$staging/agent-ship" >/dev/null
  tar -czf "$root/dist/agent-ship-$target.tar.gz" -C "$staging" agent-ship
  rm -rf "$staging"
}

main() {
  local root target
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  bun --version >/dev/null || die "bun could not run"
  (cd "$root" && bun install --frozen-lockfile >/dev/null)
  rm -rf "$root/dist"
  mkdir -p "$root/dist"
  for target in "${TARGETS[@]}"; do
    build_target "$root" "$target"
  done
  (cd "$root/dist" && shasum -a 256 -- agent-ship-*.tar.gz >SHA256SUMS.txt)
}

main "$@"
