#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'release-secrets: %s\n' "$1" >&2
  exit 1
}

mask_values() {
  local line
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      printf '::add-mask::%s\n' "$line"
    fi
  done < <(jq -r '.[] | strings' <<<"$SECRETS")
}

record_names() {
  local names
  names=$(jq -c '[to_entries[] | select(.value | type == "string" and . != "") | .key]' <<<"$SECRETS")
  printf 'names=%s\n' "$names" >>"$GITHUB_OUTPUT"
}

expose() {
  local name="$1" delimiter
  if ! jq -e --arg name "$name" '.[$name] | type == "string" and . != ""' <<<"$SECRETS" >/dev/null; then
    die "$name is not among the secrets the workflow was given"
  fi
  delimiter="SECRET_$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
  {
    printf '%s<<%s\n' "$name" "$delimiter"
    jq -r --arg name "$name" '.[$name]' <<<"$SECRETS"
    printf '%s\n' "$delimiter"
  } >>"$GITHUB_ENV"
}

main() {
  : "${SECRETS:?SECRETS is required, the JSON of the secrets context}"
  : "${CREDENTIALS:?CREDENTIALS is required, a JSON list of the names to expose}"
  : "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"
  : "${GITHUB_ENV:?GITHUB_ENV is required}"
  jq --version >/dev/null || die "jq could not run"
  jq -e 'type == "object"' <<<"$SECRETS" >/dev/null || die "SECRETS is not a JSON object"
  jq -e 'type == "array" and all(type == "string")' <<<"$CREDENTIALS" >/dev/null ||
    die "CREDENTIALS is not a JSON list of names"
  mask_values
  record_names
  local name
  while IFS= read -r name; do
    expose "$name"
  done < <(jq -r '.[]' <<<"$CREDENTIALS")
}

main "$@"
